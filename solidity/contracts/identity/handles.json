{
  "version": 2,
  "note": [
    "The single source of truth for platform identity constants, for handle",
    "normalization, and for the tags that make a value a key. Solidity, Rust,",
    "TypeScript and Noir constants are generated from this file by",
    "scripts/regen-identity-handles.py. The normalizer logic is hand written in",
    "each language -- the circuit's is the one that keys a binding -- and every",
    "language runs the same vector table, so a difference between them fails a",
    "test instead of writing a different node on chain.",
    "",
    "Normalization is a closed byte transform that refuses rather than repairs.",
    "A-Z fold to a-z and nothing else changes: no byte is trimmed, no @ is",
    "stripped. It is not Unicode case folding and not UTS-46. Handles on the",
    "supported platforms are ASCII, so a closed transform gives four languages",
    "the same answer with no shared library.",
    "",
    "A node is SHA256(tag || value): the handle node over the normalized",
    "handle, the id node over the id exactly as the platform sent it. The tags",
    "are raw ASCII with no separator or length prefix, one per platform and",
    "kind, so no two platforms and no id and handle share a key. Every",
    "handleNode and idNode below was computed independently, with Python's",
    "hashlib over the hand-written output; the generator recomputes each one",
    "and refuses a table whose stored node disagrees.",
    "",
    "A platform id is keccak256 of the platform key ('x'), with no namespace",
    "of its own. The specification fixes the keys -- the launch profiles of",
    "REQ-PLAT-01 are google, x and github -- and leaves the derivation to",
    "the profile author, so this repository pins it.",
    "",
    "The generated rulesFor takes the platform id in Solidity, where a caller",
    "has the id, and the platform key in Rust, TypeScript and Noir, where a",
    "caller has the key."
  ],
  "platforms": [
    {
      "key": "x",
      "maxLength": 15,
      "shape": "handle",
      "allowUnderscore": true,
      "allowHyphen": false,
      "note": "X allows letters, digits and underscore, up to 15 characters.",
      "tags": {
        "userId": "libid.x.user-id",
        "handle": "libid.x.handle"
      },
      "id": {
        "maxLength": 20,
        "shape": "decimal",
        "leadingZero": true,
        "note": "X user ids are decimal strings of up to 20 digits."
      }
    },
    {
      "key": "github",
      "maxLength": 39,
      "shape": "handle",
      "allowUnderscore": false,
      "allowHyphen": true,
      "note": [
        "GitHub allows letters, digits and hyphen, up to 39 characters. A hyphen",
        "may not start or end the handle, and two hyphens may not touch."
      ],
      "tags": {
        "userId": "libid.github.user-id",
        "handle": "libid.github.handle"
      },
      "id": {
        "maxLength": 20,
        "shape": "decimal",
        "leadingZero": false,
        "note": "GitHub ids are bare JSON integers, written without a leading zero."
      }
    },
    {
      "key": "google",
      "maxLength": 62,
      "shape": "email",
      "allowUnderscore": false,
      "allowHyphen": false,
      "note": [
        "The address is used as proved. This transform does not remove dots,",
        "does not strip a +tag, and does not rewrite a domain, because two",
        "different addresses must never become one identity.",
        "",
        "62 bytes is a hard limit and not only a lookup limit. A longer address",
        "is rejected instead of truncated, for the same reason.",
        "",
        "allowUnderscore and allowHyphen are stated for completeness and",
        "are never read: the email shape supersedes both, and the address",
        "set already carries the underscore and the hyphen."
      ],
      "tags": {
        "userId": "libid.google.user-id",
        "handle": "libid.google.handle"
      },
      "id": {
        "maxLength": 31,
        "shape": "printable",
        "leadingZero": true,
        "note": [
          "The OIDC sub: printable ASCII 0x20-0x7e without '\"' or '\\\\', at most",
          "31 bytes, as the oidc-google circuit reads it."
        ]
      }
    }
  ],
  "errors": [
    {
      "key": "Empty",
      "note": "Nothing is left after the transform."
    },
    {
      "key": "TooLong",
      "note": "More bytes than the platform allows."
    },
    {
      "key": "BadCharacter",
      "note": "A byte the platform does not allow."
    },
    {
      "key": "BadShape",
      "note": "Allowed bytes in an arrangement the platform does not allow."
    }
  ],
