{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!packages/contracts/src/abis",
      "!packages/contracts/src/platforms/platforms.ts",
      "!packages/contracts/src/platforms/vectors.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/contracts/src/platforms/**",
        "!packages/contracts/src/platforms/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./*", "!@noble/hashes/*"],
                    "message": "The platforms layer imports only its own directory and @noble/hashes, type-only imports included: it loads without viem, the optional peer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/contracts/src/ceremony/**",
        "!packages/contracts/src/ceremony/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!./*"],
                    "message": "The ceremony layer imports only its own directory: viem is an optional peer, and a browser ceremony reads these profiles without it."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
