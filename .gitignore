solidity/out/
solidity/cache/
solidity/broadcast/
ts/node_modules/
ts/packages/*/node_modules/
ts/packages/*/dist/

# Generated from `forge build` and packaged into the crate and the npm
# package; CI regenerates them before every build, test, dry-run and publish.
#   scripts/vendor-artifacts.sh     # -> rust/contracts/artifacts{,-testing}, rust/contracts/abi
#   pnpm -C ts codegen              # -> ts/packages/contracts/src/abis
rust/contracts/artifacts/
rust/contracts/artifacts-testing/
rust/contracts/abi/
ts/packages/contracts/src/abis/
ts/packages/contracts/src/calls/

# Vendored from the pinned libid-circuits release: the Honk verifiers and the
# platform table. circuits.json beside them, committed, is the pin every
# download is checked against. Vendor before `forge build` or a regen script:
#   scripts/vendor-circuit-verifiers.sh  # -> solidity/contracts/circuits/*HonkVerifier.sol, platforms.json, handles.json
solidity/contracts/circuits/*HonkVerifier.sol
solidity/contracts/circuits/platforms.json
solidity/contracts/circuits/handles.json

# Python bytecode from the generator scripts.
__pycache__/
